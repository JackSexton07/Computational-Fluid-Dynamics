forceCoeffs1
{
    type            forceCoeffs;

    libs            (forces);

    writeControl    timeStep;
    writeInterval   1;

    log             yes;

    patches         (mustangGroup);
    rho             rhoInf;      // Indicates incompressible
    rhoInf          1;           // Required when rho = rhoInf
    liftDir         (0 0 1);
    dragDir         (1 0 0);
    CofR            (2.294 0 0);  // Wheelbase midpoint on the ground (axles at x = 0.926, 3.662)
    pitchAxis       (0 1 0);
    magUInf         40;
    lRef            2.736;        // Wheelbase (measured from the wheel centres)
    Aref            2.2695;       // Measured with tools/frontal_area.py       
}

